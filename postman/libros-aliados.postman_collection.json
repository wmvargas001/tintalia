{
  "info": {
    "name": "Tintalia - Catálogo de libros aliados",
    "description": "Consultas a APIs públicas de libros para obtener ficha y sinopsis. Open Library no requiere clave. JSONPlaceholder alimenta /usuarios. \"Sitio desplegado\" comprueba las páginas publicadas en baseUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://tintalia.vercel.app" },
    { "key": "query", "value": "cien años de soledad" },
    { "key": "isbn", "value": "9780307474728" },
    { "key": "workKey", "value": "OL274505W" }
  ],
  "item": [
    {
      "name": "Open Library",
      "item": [
        {
          "name": "Buscar libros",
          "request": {
            "method": "GET",
            "url": {
              "raw": "https://openlibrary.org/search.json?q={{query}}&limit=5&fields=key,title,author_name,first_publish_year,isbn,cover_i,language",
              "protocol": "https",
              "host": ["openlibrary", "org"],
              "path": ["search.json"],
              "query": [
                { "key": "q", "value": "{{query}}" },
                { "key": "limit", "value": "5" },
                { "key": "fields", "value": "key,title,author_name,first_publish_year,isbn,cover_i,language" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const docs = pm.response.json().docs;",
                  "pm.test('Hay resultados', () => pm.expect(docs.length).to.be.above(0));",
                  "if (docs.length) {",
                  "  pm.collectionVariables.set('workKey', docs[0].key.replace('/works/', ''));",
                  "  console.log('Primer resultado:', docs[0].title, '-', (docs[0].author_name || []).join(', '));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Sinopsis de la obra",
          "request": {
            "method": "GET",
            "url": {
              "raw": "https://openlibrary.org/works/{{workKey}}.json",
              "protocol": "https",
              "host": ["openlibrary", "org"],
              "path": ["works", "{{workKey}}.json"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const work = pm.response.json();",
                  "// description puede venir como string o como { type, value }",
                  "const synopsis = typeof work.description === 'string' ? work.description : work.description && work.description.value;",
                  "pm.test('Tiene sinopsis', () => pm.expect(synopsis).to.be.a('string'));",
                  "console.log('Sinopsis:', (synopsis || '').slice(0, 300));"
                ]
              }
            }
          ]
        },
        {
          "name": "Libro por ISBN",
          "request": {
            "method": "GET",
            "url": {
              "raw": "https://openlibrary.org/api/books?bibkeys=ISBN:{{isbn}}&format=json&jscmd=data",
              "protocol": "https",
              "host": ["openlibrary", "org"],
              "path": ["api", "books"],
              "query": [
                { "key": "bibkeys", "value": "ISBN:{{isbn}}" },
                { "key": "format", "value": "json" },
                { "key": "jscmd", "value": "data" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const book = pm.response.json()['ISBN:' + pm.variables.get('isbn')];",
                  "pm.test('ISBN encontrado', () => pm.expect(book).to.be.an('object'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Portada por ISBN",
          "request": {
            "method": "GET",
            "url": {
              "raw": "https://covers.openlibrary.org/b/isbn/{{isbn}}-L.jpg?default=false",
              "protocol": "https",
              "host": ["covers", "openlibrary", "org"],
              "path": ["b", "isbn", "{{isbn}}-L.jpg"],
              "query": [{ "key": "default", "value": "false" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Portada disponible', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "JSONPlaceholder (página /usuarios)",
      "item": [
        {
          "name": "Usuarios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": {
              "raw": "https://jsonplaceholder.typicode.com/users",
              "protocol": "https",
              "host": [
                "jsonplaceholder",
                "typicode",
                "com"
              ],
              "path": [
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const users = pm.response.json();",
                  "pm.test('Hay usuarios', () => pm.expect(users).to.be.an('array').that.is.not.empty);",
                  "pm.test('Traen los campos que muestra la página', () => {",
                  "  users.forEach((u) => {",
                  "    pm.expect(u.id).to.be.a('number');",
                  "    pm.expect(u.name).to.be.a('string');",
                  "    pm.expect(u.email).to.be.a('string');",
                  "    pm.expect(u.company.name).to.be.a('string');",
                  "  });",
                  "});",
                  "pm.test('El navegador puede leerla desde el sitio (CORS)', () => {",
                  "  const allow = pm.response.headers.get('Access-Control-Allow-Origin');",
                  "  pm.expect(['*', pm.collectionVariables.get('baseUrl')]).to.include(allow);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Publicaciones de un usuario",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": {
              "raw": "https://jsonplaceholder.typicode.com/posts?userId=1",
              "protocol": "https",
              "host": [
                "jsonplaceholder",
                "typicode",
                "com"
              ],
              "path": [
                "posts"
              ],
              "query": [
                {
                  "key": "userId",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const posts = pm.response.json();",
                  "pm.test('Hay publicaciones', () => pm.expect(posts).to.be.an('array').that.is.not.empty);",
                  "pm.test('Son del usuario pedido y traen título y texto', () => {",
                  "  posts.forEach((p) => {",
                  "    pm.expect(p.userId).to.eql(1);",
                  "    pm.expect(p.title).to.be.a('string');",
                  "    pm.expect(p.body).to.be.a('string');",
                  "  });",
                  "});",
                  "pm.test('El navegador puede leerla desde el sitio (CORS)', () => {",
                  "  const allow = pm.response.headers.get('Access-Control-Allow-Origin');",
                  "  pm.expect(['*', pm.collectionVariables.get('baseUrl')]).to.include(allow);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
